# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE / editor
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Generated data & outputs (regenerated by running the pipeline)
data/*.csv
outputs/charts/*.png
outputs/reports/*.csv
outputs/reports/*.txt
outputs/reports/*.md

# Keep folder structure via .gitkeep if used
!.gitkeep
